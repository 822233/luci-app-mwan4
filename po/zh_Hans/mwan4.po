msgid "Tries per target"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "How many tries are sent to each target in one round of checks. If left empty, 1 is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Ping size (bytes)"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
