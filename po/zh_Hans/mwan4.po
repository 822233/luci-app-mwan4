msgid "Check every (seconds) after a failure"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Time between rounds right after a check fails, to confirm quickly whether the link is down. If left empty, 5 seconds are used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Check every (seconds) while recovering"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Time between rounds while a down link is tested for recovery. If left empty, 5 seconds are used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "How many failed checks in a row mark the link down. High values tolerate short glitches but react later. If left empty, 5 is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "How many good checks in a row bring a down link back. If left empty, 5 is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Keep checking quickly while down"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Keep using the faster interval after a failure until the link recovers, instead of slowing down. Off by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Besides answering, a link is marked degraded when replies are slow or lost, using the limits below. Needs the Ping method. Off by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Reply time above which the link counts as degraded. If left empty, 1000 ms is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Share of lost replies above which the link counts as degraded. If left empty, 40 % is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Reply time the link must stay under to count as healthy again. If left empty, 500 ms is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Share of lost replies the link must stay under to count as healthy again. If left empty, 10 % is used."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
