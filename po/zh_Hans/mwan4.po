msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Addresses used to test this WAN link. Use at least two: with a single target one lost reply can mark the link down. If left empty, the link is not tested."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "How each target is tested. Methods other than ping need extra tools and are listed only when installed. Ping by default."
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Use HTTPS for web page requests"
msgstr ""

#: luci-app-mwan4/htdocs/luci-static/resources/mwan4/fields.js
msgid "Make web page requests use HTTPS instead of HTTP. Off by default."
msgstr ""

